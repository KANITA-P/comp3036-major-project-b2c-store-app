{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalEnv": [
    "ADMIN_EMAIL",
    "ADMIN_PASSWORD",
    "ADMIN_JWT_SECRET",
    "VITEST",
    "E2E",
    "TEST_DATABASE_URL",
    "DATABASE_URL",
    "JWT_SECRET",
    "NEXT_PUBLIC_ADMIN_URL",
    "NODE_ENV"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["build", "^check-types"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["^build", "check-types"],
      "outputs": []
    },
    "dev:test": {
      "dependsOn": ["check-types"]
    },
    "db:generate": {
      "dependsOn": ["^db:generate"]
    }
  },
  "envMode": "loose"
}
